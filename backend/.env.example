# ── 应用 ──
DEPLOY_ENV=DEVELOPMENT
DEBUG=true
SECRET_KEY=change-me-in-production
BASE_URL_PATH=/vllm_manager

# ── 数据库（PostgreSQL）──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=vllm_manager
DB_PG_SCHEMA=public
# 表名前缀（业务表建议带上，多应用共库时避免冲突）
TABLE_NAME_PREFIX=vllm_manager

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── 日志 ──
# LOG_LEVEL=INFO
# LOG_FILE={BASE_PATH}/logs/app.log

# ── 可选配置（注释形式，均有默认值）──
# PUBLIC_ACCESS_DOMAIN=http://127.0.0.1:8000
# SESSION_MAX_AGE=172800
# SESSION_HTTPS_ONLY=false
# DISABLED_EXTENSIONS=        # 逗号分隔：db / redis / saq（logging 不可禁用）
# INSTANCE_REQUEST_TIMEOUT=15
# INSTANCE_WEIGHT_TIMEOUT=15
# INSTANCE_RECONCILE_INTERVAL=15

